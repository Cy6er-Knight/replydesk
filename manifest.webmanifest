{
  "name": "ReplyDesk",
  "short_name": "ReplyDesk",
  "description": "Answer the same student emails in seconds. Pick a student, pick a template, open an Outlook draft.",
  "id": "./",
  "start_url": "./#/dashboard",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f5f7",
  "theme_color": "#0071e3",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New email", "url": "./#/builder", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Students", "url": "./#/students", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
